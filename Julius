-- ==============================================
-- 🔄 MAIN LOOP — อัปเดต ESP + ล็อกเป้า + มุดดิน
-- ==============================================
RunService.RenderStepped:Connect(function()
    -- มุดดิน
    if State.DigEnabled and Root then
        Root.Position -= Vector3.new(0, State.DigDepth, 0)
    end

    -- ล็อกเป้า
    if State.TargetEnabled then
        local closest, minDist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local pr = p.Character.HumanoidRootPart
                local d = (Root.Position - pr.Position).Magnitude
                if d <= State.Range and d < minDist then
                    minDist = d
                    closest = p
                end
            end
        end
        State.TargetPlayer = closest
        if closest then
            TgtInfo.Text = "🎯 " .. closest.Name .. " | " .. math.floor(minDist) .. " ม."
        else
            TgtInfo.Text = "เป้าหมาย: ไม่มี"
        end
    else
        TgtInfo.Text = "เป้าหมาย: ไม่มี"
    end

    -- ==============================================
    -- 👁️ ESP SYSTEM — เห็นชื่อ + ระยะ + กล่องรอบตัว
    -- ==============================================
    if not State.ESP_Enabled then
        for _, v in pairs(ESP_Objects) do if v then v.Visible = false end end
        return
    end

    -- ลบ ESP คนที่ออก
    for name, obj in pairs(ESP_Objects) do
        local p = Players:FindFirstChild(name)
        if not p or not p.Character then
            obj:Destroy()
            ESP_Objects[name] = nil
        end
    end

    -- สร้าง/อัปเดต ESP แต่ละคน
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not p.Character then continue end
        local pr = p.Character:FindFirstChild("HumanoidRootPart")
        local head = p.Character:FindFirstChild("Head")
        if not pr or not head then continue end

        local camCF = workspace.CurrentCamera.CFrame
        local pos, onScr = workspace.CurrentCamera:WorldToScreenPoint(pr.Position)
        local dist = (camCF.Position - pr.Position).Magnitude

        -- สร้างถ้ายังไม่มี
        if not ESP_Objects[p.Name] then
            local c = Instance.new("Folder")
            c.Name = "ESP_" .. p.Name
            c.Parent = Gui

            -- กล่องรอบตัว
            local Box = Instance.new("Frame")
            Box.Size = UDim2.fromOffset(60, 120)
            Box.Position = UDim2.new(0.5, -30, 0.5, -60)
            Box.BackgroundTransparency = 1
            Box.BorderSizePixel = 2
            Box.BorderColor3 = CONFIG.ESP_BoxColor
            Box.Parent = c

            -- ชื่อ
            local NameLbl = Instance.new("TextLabel")
            NameLbl.Size = UDim2.fromOffset(120, 24)
            NameLbl.Position = UDim2.new(0.5, -60, 0, -30)
            NameLbl.BackgroundTransparency = 1
            NameLbl.Text = p.Name
            NameLbl.TextColor3 = CONFIG.ESP_NameColor
            NameLbl.TextScaled = true
            NameLbl.Font = Enum.Font.GothamBold
            NameLbl.Parent = c

            -- ระยะ
            local DistLbl = Instance.new("TextLabel")
            DistLbl.Size = UDim2.fromOffset(80, 20)
            DistLbl.Position = UDim2.new(0.5, -40, 1, 5)
            DistLbl.BackgroundTransparency = 1
            DistLbl.Text = math.floor(dist) .. " ม."
            DistLbl.TextColor3 = CONFIG.ESP_DistColor
            DistLbl.TextScaled = true
            DistLbl.Font = Enum.Font.GothamBold
            DistLbl.Parent = c

            ESP_Objects[p.Name] = {Folder = c, Box = Box, Name = NameLbl, Dist = DistLbl}
        end

        local E = ESP_Objects[p.Name]
        local scale = 180 / dist -- ปรับขนาดตามระยะ
        local x, y = pos.X, pos.Y

        -- แสดง/ซ่อน ตามการตั้งค่า
        E.Folder.Visible = onScr
        if not onScr then continue end

        -- ตำแหน่งบนจอ
        E.Folder.Position = UDim2.new(0, x - 40*scale, 0, y - 60*scale)

        -- กล่อง
        E.Box.Visible = State.ESP_ShowBox
        E.Box.Size = UDim2.fromOffset(60*scale, 120*scale)
        E.Box.Position = UDim2.new(0.5, -30*scale, 0.5, -60*scale)

        -- ชื่อ
        E.Name.Visible = State.ESP_ShowName
        E.Name.Text = p.Name

        -- ระยะ
        E.Dist.Visible = State.ESP_ShowDist
        E.Dist.Text = math.floor(dist) .. " ม."
    end
end)

