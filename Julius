local function CreateTab(name)
    local t = Instance.new("ScrollingFrame")
    t.Name = name
    t.Size = UDim2.fromScale(1,1)
    t.BackgroundColor3 = Color3.fromRGB(22,22,48)
    t.BackgroundTransparency = 0.35
    t.BorderSizePixel = 0
    t.ScrollBarThickness = 8
    t.ScrollBarImageColor3 = Colors.Active
    t.AutomaticCanvasSize = Enum.AutomaticSize.Y
    t.Visible = false
    t.Parent = Content

    local Pad = Instance.new("UIPadding")
    Pad.PaddingTop = UDim.new(0,12)
    Pad.PaddingBottom = UDim.new(0,20)
    Pad.PaddingLeft = UDim.new(0,12)
    Pad.PaddingRight = UDim.new(0,12)
    Pad.Parent = t

    local Lay = Instance.new("UIListLayout")
    Lay.Padding = UDim.new(0,12)
    Lay.SortOrder = Enum.SortOrder.LayoutOrder
    Lay.Parent = t
    Lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        t.CanvasSize = UDim2.new(0,0,0,Lay.AbsoluteContentSize.Y+20)
    end)

    Tabs[name] = t
    return t
end

